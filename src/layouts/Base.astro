---
import '../styles/global.css'; import {temas,bloques} from '../data/temas'; const {title='CSS Esencial'}=Astro.props; const current=Astro.url.pathname;
---
<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="icon" type="image/png" href="/images/favicon.png"><title>{title}</title></head><body><a class="skip" href="#contenido">Saltar al contenido</a><header><a href="/" class="brand">CSS <span>Esencial</span></a><p>Aprende CSS desde cero</p></header><div class="shell"><aside><nav aria-label="Índice">{bloques.map(b=><section><h2>{b}</h2><ol>{temas.filter(x=>x.b===b).map(x=><li><a href={x.h} aria-current={current===x.h?'page':undefined}>{x.n}. {x.t}</a></li>)}</ol></section>)}</nav></aside><main id="contenido"><slot/></main></div><footer><p>CSS Esencial · Material de estudio práctico</p><p>Para ampliar tus conocimientos, visita el <a href="https://resumencss.vercel.app/">manual completo de CSS</a>.</p></footer></body></html>
