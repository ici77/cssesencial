---
import Base from '../layouts/Base.astro';
import TopicNav from './TopicNav.astro';
import InfoGraphic from './InfoGraphic.astro';
const { n, title, lead, objectives, concept, html, css, practice, summary, questions = [], image, lab = 'color' } = Astro.props;
const sections = [['concepto','Comprende el concepto'],['ejemplo','Observa un ejemplo'],['laboratorio','Experimenta'],['practica','Prueba tú'],['resumen','Resumen de consulta'],['comprobacion','Comprueba lo aprendido']];
const ampliaciones = {
  1: [['HTML y CSS trabajan juntos','HTML aporta significado: títulos, párrafos, enlaces e imágenes. CSS no crea ese contenido; decide su presentación. Separarlos permite reutilizar una misma hoja de estilos en varias páginas y modificar el diseño sin reescribir la estructura.'],['Conectar archivos sin perderse','Si index.html y estilos.css están en la misma carpeta, href="estilos.css" es una ruta relativa. Si la hoja está dentro de una carpeta css, escribe href="css/estilos.css". Un error habitual es escribir una ruta que no coincide con las carpetas reales.'],['Antes y después','Prueba primero una página solo con HTML. Después añade color, fuente y espacio desde estilos.css. Si nada cambia, abre las herramientas del navegador: normalmente el problema está en link, en el nombre del archivo o en una regla mal escrita.']],
  2: [['Primero etiqueta, después clase','El selector p afecta a todos los párrafos. Es útil para una regla común. Una clase como .aviso se añade con class="aviso" y permite distinguir varios elementos sin dejar de usar su etiqueta.'],['Clases e ID no son rivales','Una clase puede repetirse; un ID debe ser único en la página. Un elemento puede tener varias clases: class="aviso urgente". Así reúne dos patrones sin crear reglas duplicadas.'],['Leer espacios y comas','La coma significa “estos selectores”. p, h2 afecta a ambos. El espacio expresa “dentro de”: nav a solo selecciona enlaces dentro de nav. :hover y :focus describen estados que puede tener un elemento.']],
  3: [['La cascada resuelve conflictos','Dos reglas pueden seleccionar el mismo párrafo. Si tienen la misma prioridad, gana la que aparece más tarde. Esto permite establecer una base y corregir un caso concreto después.'],['Especificidad sin cálculos complicados','Como guía inicial: un ID pesa más que una clase, y una clase más que una etiqueta. La especificidad solo se compara cuando las reglas compiten en el mismo elemento.'],['Herencia no es una copia total','Un hijo suele heredar color y font-family de su padre. Sin embargo, margin, border y background no suelen heredarse. Una declaración directa en el hijo normalmente vence al valor heredado.']],
  4: [['Color y fondo resuelven preguntas distintas','color pinta las letras; background-color pinta el área de la caja. Puedes nombrar un color, usar HEX como #6d3fa9 o RGB como rgb(109, 63, 169). Comprueba siempre que texto y fondo tengan contraste.'],['Fondos con imagen','background-image coloca un recurso decorativo. background-repeat evita mosaicos, background-size controla su escala y background-position decide qué zona se ve. No uses una imagen de fondo para información esencial.'],['Texto para leer, no solo decorar','font-family establece una lista de respaldo. font-size y font-weight crean jerarquía. line-height da aire entre líneas; text-align, text-decoration y text-transform deben mejorar el contenido, no dificultarlo.']],
  5: [['La caja por capas','Imagina una caja de regalo: contenido es el regalo, padding es el relleno, border es la pared y margin es la distancia hasta otra caja. El fondo llega hasta el padding, pero no ocupa el margin.'],['Cuatro valores con un orden fijo','Con un valor cambian los cuatro lados. Con dos, vertical y horizontal. Con tres, arriba, lados y abajo. Con cuatro el orden es arriba, derecha, abajo, izquierda. Escríbelo siempre en ese sentido.'],['Tamaño y márgenes automáticos','content-box suma padding y border al ancho declarado. border-box los incluye. max-width evita cajas excesivamente anchas. margin: 0 auto centra una caja de bloque con ancho disponible menor; text-align:center solo centra contenido en línea.']],
  6: [['El flujo normal es el punto de partida','Sin reglas especiales, bloques como div y p se apilan y los elementos en línea fluyen dentro de una frase. CSS display cambia esa participación, no el significado HTML.'],['Comparar block, inline e inline-block','block inicia línea y acepta ancho. inline comparte línea, pero width y height no tienen el mismo efecto. inline-block comparte línea y permite controlar su caja: resulta práctico para enlaces que parecen botones.'],['Ocultar y desbordar no son lo mismo','display:none elimina el hueco; visibility:hidden lo conserva. overflow:visible deja salir el contenido; hidden lo recorta; auto muestra desplazamiento cuando hace falta y scroll lo reserva siempre.']],
  7: [['Un padre organiza a sus hijos','display:flex se coloca en el contenedor. Solo sus hijos directos son flex items. Flexbox resuelve alineación y reparto en una dimensión de forma más clara que márgenes improvisados.'],['Piensa en ejes antes de alinear','flex-direction:row usa una dirección principal horizontal; column la vuelve vertical. justify-content actúa en el eje principal y align-items en el transversal. No memorices horizontal o vertical: mira primero la dirección.'],['Patrones útiles y suficientes','gap separa hijos de forma constante. flex-wrap:wrap permite que tarjetas pasen a otra línea. flex:1 es un atajo práctico para que varios elementos compartan el espacio disponible.']],
  8: [['Grid dibuja una cuadrícula','display:grid crea un contenedor de filas y columnas. Mientras Flexbox es excelente para una dirección, Grid es ideal cuando necesitas controlar simultáneamente columnas y filas.'],['Repartir con fr y repeat','1fr es una fracción del espacio disponible. grid-template-columns:1fr 1fr crea dos columnas iguales; repeat(3,1fr) evita repetir la misma unidad. gap separa las celdas.'],['Cuadrículas adaptables','minmax(220px,1fr) marca el mínimo útil de una tarjeta. repeat(auto-fit,minmax(...)) crea tantas columnas como quepan. grid-column:span 2 permite destacar una tarjeta sin aprender áreas complejas.']],
  9: [['Adaptarse al espacio disponible','Responsive no significa diseñar para una lista de dispositivos: significa que el contenido puede cambiar de forma cuando cambia el espacio. La meta viewport permite que el navegador móvil use el ancho real del dispositivo.'],['Primero flexible, después límite','width:100% permite ocupar el contenedor y max-width evita que una lectura se vuelva demasiado ancha. Las imágenes deben poder reducirse con max-width:100% y height:auto.'],['Mobile First y media queries','Escribe primero una columna, que funciona en cualquier pantalla. Después usa @media (min-width:...) para añadir columnas cuando caben. Los breakpoints se eligen cuando el contenido lo pide, no por una cifra obligatoria.']]
};
const desarrollo = ampliaciones[n] ?? [];
---
<Base title={`Tema ${n} · ${title}`}>
  <header class="lesson-header"><p class="eyebrow">Tema {n} · CSS Esencial</p><h1>{title}</h1><p class="lead">{lead}</p></header>
  <nav class="lesson-index" aria-label="Apartados de la lección"><strong>En esta lección</strong>{sections.map(([id,label]) => <a href={`#${id}`}>{label}</a>)}</nav>
  <section class="objectives"><h2>Qué vas a aprender</h2><ul>{objectives.map((item) => <li>{item}</li>)}</ul></section>
  <section id="concepto"><h2>Comprende el concepto</h2><slot name="concepto"><p>{concept}</p></slot><aside class="key"><strong>Idea clave.</strong> No memorices una regla aislada: relaciona siempre el selector, la propiedad y el resultado visible.</aside></section>
  {desarrollo.map(([heading, text]) => <section class="development"><h2>{heading}</h2><p>{text}</p></section>)}
  <section id="ejemplo" class="example"><h2>Observa un ejemplo</h2><p>Lee primero el HTML: indica qué hay en la página. Después observa la regla CSS y compara el resultado.</p><div class="code-grid"><div><h3>HTML</h3><pre><code id="html-code">{html}</code></pre><button class="copy" data-copy="html-code">Copiar HTML</button></div><div><h3>CSS</h3><pre><code id="css-code">{css}</code></pre><button class="copy" data-copy="css-code">Copiar CSS</button></div></div><div class="result"><h3>Resultado en el navegador</h3><iframe title={`Ejemplo del tema ${n}`} sandbox="" srcdoc={`<!doctype html><style>body{font:16px/1.5 system-ui;padding:16px;color:#272332;background:#fff}${css}</style>${html}`}></iframe><p>El navegador aplica la regla únicamente a los elementos que coinciden con el selector.</p></div></section>
  {image && <InfoGraphic {...image} />}
  <section id="laboratorio" class="lab"><h2>Laboratorio guiado</h2><p>Cambia un valor, observa el efecto y lee el CSS generado. Después restaura el punto de partida.</p><label for="lab-input">{lab === 'size' ? 'Tamaño del texto' : 'Color del texto'} <input id="lab-input" type={lab === 'size' ? 'range' : 'color'} min="8" max="64" value={lab === 'size' ? '20' : '#6d3fa9'} /></label><div id="lab-output" class="lab-output" style={`padding:1rem;background:#f2ebfa;${lab === 'size' ? 'font-size:20px' : 'color:#6d3fa9'}`}>Este resultado cambia cuando modificas el control.</div><code id="lab-code"></code><div class="actions"><button type="button" id="lab-copy">Copiar CSS</button><button type="button" id="lab-reset">Restaurar</button></div><p id="lab-note" aria-live="polite"></p></section>
  <section id="practica" class="practice"><h2>Prueba tú</h2><p>{practice}</p><details><summary>Ver una orientación</summary><p>Escribe primero el HTML, enlaza tu hoja CSS y añade una única regla. Guarda los dos archivos y actualiza el navegador. Si no ves cambios, revisa el selector, los dos puntos y la ruta del archivo.</p></details></section>
  <section id="resumen"><h2>Resumen de consulta</h2><div class="table-wrap"><table><thead><tr><th>Elemento</th><th>Para qué sirve</th><th>Ejemplo</th></tr></thead><tbody>{summary.map(([a,b,c]) => <tr><td><code>{a}</code></td><td>{b}</td><td><code>{c}</code></td></tr>)}</tbody></table></div></section>
  <section id="comprobacion" class="quiz"><h2>Comprueba lo aprendido</h2><p>Marca una opción por pregunta y corrige al final. Las respuestas no se muestran hasta que decidas comprobarlas.</p>{questions.map(([question, options, correct, explanation], index) => <fieldset data-correct={correct}><legend>{index + 1}. {question}</legend>{options.map((option, optionIndex) => <label><input type="radio" name={`q${index}`} value={optionIndex} /> {option}</label>)}<p hidden>{explanation}</p></fieldset>)}<div class="actions"><button id="grade" type="button">Corregir</button><button id="restart" type="button">Reiniciar</button></div><p id="score" aria-live="polite"></p></section>
  <TopicNav n={n} />
</Base>
<script is:inline>
const copyText=async(id,note)=>{try{await navigator.clipboard.writeText(document.querySelector('#'+id).textContent);note.textContent='Código copiado.'}catch{note.textContent='No se pudo copiar automáticamente: selecciona el código y cópialo manualmente.'}};
document.querySelectorAll('.copy').forEach(button=>button.addEventListener('click',()=>copyText(button.dataset.copy,button)));
const input=document.querySelector('#lab-input'),out=document.querySelector('#lab-output'),code=document.querySelector('#lab-code'),note=document.querySelector('#lab-note'),size=input.type==='range';
function update(){const value=input.value+(size?'px':'');out.style[size?'fontSize':'color']=value;code.textContent=(size?'font-size: ':'color: ')+value+';';note.textContent=size?'El tamaño cambia sin modificar la estructura HTML.':'El color se aplica al texto del resultado.'} input.addEventListener('input',update);document.querySelector('#lab-reset').onclick=()=>{input.value=size?20:'#6d3fa9';update();note.textContent='Valores iniciales restaurados.'};document.querySelector('#lab-copy').onclick=()=>copyText('lab-code',note);update();
const fields=[...document.querySelectorAll('.quiz fieldset')];document.querySelector('#grade').onclick=()=>{let score=0;fields.forEach(field=>{const chosen=field.querySelector('input:checked'),ok=chosen&&+chosen.value===+field.dataset.correct;score+=ok?1:0;field.querySelector('p').hidden=false;field.className=ok?'correct':'incorrect'});document.querySelector('#score').textContent=`Resultado: ${score} de ${fields.length}.`};document.querySelector('#restart').onclick=()=>{fields.forEach(field=>{field.querySelectorAll('input').forEach(input=>input.checked=false);field.querySelector('p').hidden=true;field.className='' });document.querySelector('#score').textContent=''};
</script>
