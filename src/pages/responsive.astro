import Lesson from '../components/Lesson.astro'; const q=[['¿Qué configura el ancho móvil?',['meta viewport','title','footer','hover'],0,'viewport adapta el área visual.'],['¿Qué evita crecer demasiado?',['max-width','font-style','ID','float'],0,'max-width pone un límite.'],['¿Qué enfoque empieza en móvil?',['Mobile First','Desktop Last','Float First','ID First'],0,'Primero base pequeña.'],['¿Qué introduce breakpoint?',['@media','@font','@keyframes','@import'],0,'@media aplica reglas según condición.'],['¿Los breakpoints son fijos?',['Sí','No','Solo 768','Solo 1024'],1,'Se eligen según el contenido.']];
---
<Lesson n={9} title="Diseño responsive esencial" lead="Una página responsive se adapta al espacio disponible, no a una lista rígida de dispositivos." objectives={['Evitar anchuras fijas','Usar media queries','Crear columnas adaptables']} concept="Incluye meta viewport. width:100% permite ocupar el contenedor y max-width fija un límite. Las imágenes deben poder reducirse. Mobile First escribe primero la base de una columna y añade @media min-width cuando el contenido necesita más espacio. Los puntos de ruptura son orientativos." html={'<section class="catalogo"><article>A</article><article>B</article></section>'} css={'.catalogo { display:grid; grid-template-columns:1fr; gap:16px; }\n@media (min-width:768px) { .catalogo { grid-template-columns:repeat(2,1fr); } }'} practice="Haz un catálogo de una columna y añade dos columnas a partir de 768px." summary={[['width:100%','ancho flexible','width:100%'],['max-width','límite','max-width:600px'],['@media','regla condicional','min-width:768px']]} questions={q} image={{src:'/images/Diseño responsive_ espacios que se adaptan.png',alt:'Diseño responsive y tamaños',caption:'Diseño responsive: espacio disponible'}} />
