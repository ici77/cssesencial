import Lesson from '../components/Lesson.astro'; const q=[['¿Qué espacio es interior?',['margin','padding','border','width'],1,'padding está dentro.'],['¿Qué separa cajas?',['padding','margin','content','height'],1,'margin queda fuera.'],['¿Qué incluye padding y borde?',['content-box','border-box','inline','auto'],1,'border-box simplifica el cálculo.'],['¿Qué centra una caja estrecha?',['text-align:center','margin:0 auto','color','gap'],1,'Los márgenes automáticos centran la caja.'],['¿Cuál es el orden abreviado?',['Izq-arriba','Arriba-derecha-abajo-izquierda','Solo horizontal','Aleatorio'],1,'Es el sentido de las agujas del reloj.']];
---
<Lesson n={5} title="Modelo de caja esencial" lead="Todo elemento ocupa una caja formada por contenido, relleno, borde y margen." objectives={['Distinguir padding y margin','Usar border-box','Controlar tamaños']} concept="El contenido es lo que muestra la caja. padding crea aire interior; border dibuja el límite; margin separa cajas. Con box-sizing: border-box, width incluye padding y borde. En abreviaturas el orden es arriba, derecha, abajo, izquierda. text-align centra texto; margin: 0 auto centra una caja con ancho menor." html={'<div class="caja">Contenido</div>'} css={'.caja { width: 240px; padding: 20px; border: 4px solid #6d3fa9; margin: 20px auto; box-sizing: border-box; }'} practice="Crea una ficha de 280px, céntrala con margin: 0 auto y añade padding, borde y radio." summary={[['padding','aire interior','padding: 16px'],['margin','aire exterior','margin: 0 auto'],['box-sizing','cálculo estable','border-box']]} questions={q} image={{src:'/images/Guía visual del modelo de cajas CSS.png',alt:'Modelo de cajas CSS',caption:'Modelo de caja y box-sizing'}} lab="size" />
