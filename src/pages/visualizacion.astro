import Lesson from '../components/Lesson.astro'; const q=[['¿Qué inicia línea nueva?',['inline','block','none','hidden'],1,'block ocupa su línea.'],['¿Qué permite ancho y sigue en línea?',['inline-block','none','hidden','static'],0,'inline-block combina ambos comportamientos.'],['¿Qué elimina el hueco?',['visibility:hidden','display:none','overflow:auto','block'],1,'none elimina del flujo.'],['¿Qué mantiene el hueco?',['hidden visibility','none','block','scroll'],0,'visibility hidden conserva espacio.'],['¿Qué añade barra si hace falta?',['visible','auto','hidden','inline'],1,'auto depende del contenido.']];
---
<Lesson n={6} title="Visualización de elementos" lead="display decide cómo participa una caja en el flujo normal del documento." objectives={['Distinguir bloque y línea','Ocultar correctamente','Controlar overflow']} concept="Un bloque empieza una línea nueva; un elemento en línea fluye dentro del texto. inline-block permite dar ancho y alto sin romper la línea. display:none elimina el elemento y visibility:hidden conserva su hueco. overflow visible deja salir el contenido; hidden lo recorta; auto y scroll permiten desplazamiento." html={'<span>Uno</span><span>Dos</span><div>Tres</div>'} css={'span { display: inline-block; padding: 8px; }\ndiv { display: block; }'} practice="Convierte tres enlaces en botones inline-block y prueba none frente a visibility:hidden." summary={[['block','nueva línea','display:block'],['inline','fluye con texto','display:inline'],['auto','scroll si hace falta','overflow:auto']]} questions={q} image={{src:'/images/Infografía_ Display y flujo normal en CSS.png',alt:'Display y flujo normal',caption:'Display y flujo normal'}} />
