import Lesson from '../components/Lesson.astro'; const q=[['¿Qué activa Grid?',['display:grid','flex:1','position:grid','grid:on'],0,'display:grid activa el contenedor.'],['¿Qué unidad reparte espacio?',['px','fr','em','%'],1,'fr es una fracción disponible.'],['¿Qué repite columnas?',['repeat()','hover','auto','span'],0,'repeat reduce repeticiones.'],['¿Qué separa celdas?',['gap','border','margin solo','ID'],0,'gap separa tracks.'],['¿Qué adapta tarjetas?',['minmax y auto-fit','z-index','float','important'],0,'Grid puede repetir columnas adaptables.']];
---
<Lesson n={8} title="CSS Grid esencial" lead="Grid organiza elementos en filas y columnas, ideal para catálogos y galerías." objectives={['Crear columnas','Usar fr y repeat','Construir una cuadrícula adaptable']} concept="display:grid se aplica al contenedor. grid-template-columns define columnas; 1fr reparte una parte del espacio. repeat(3,1fr) crea tres columnas. gap separa las celdas. grid-column: span 2 permite que una tarjeta ocupe dos columnas. auto-fit y minmax ayudan a que la cuadrícula se adapte." html={'<section><article>1</article><article>2</article><article>3</article></section>'} css={'section { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }'} practice="Crea seis tarjetas: empieza con dos columnas y prueba repeat(3,1fr)." summary={[['display:grid','activa Grid','display:grid'],['fr','fracción','1fr 1fr'],['repeat','repite tracks','repeat(3,1fr)']]} questions={q} image={{src:'/images/Infografía CSS Grid_ Áreas y Layouts Responsive.png',alt:'CSS Grid y áreas',caption:'CSS Grid: filas y columnas'}} />
